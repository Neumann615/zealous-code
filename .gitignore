# agent-assets 为本机只读参考源码区,不进入版本管理(仅追踪其 README)
/agent-assets/*
!/agent-assets/README.md

# 依赖
node_modules/

# 构建产物
dist/
build/
out/
/target/

# 缓存
.cache/
*.tsbuildinfo

# 日志与临时文件
*.log
logs/
tmp/

# 工具目录
.zcode/
# 任务运行时数据(开发/测试时在本仓库内产生)
.zealous/
# 本地密钥配置(含 API key,禁止入库)
.env
# 本地发布候选产物(spec 120)
dist/

# 操作系统 / 编辑器
.DS_Store
Thumbs.db
